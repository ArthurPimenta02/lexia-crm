{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.uselexia.invalid/omnichannel/v1/brain-request.schema.json",
  "title": "Lexia Brain Request v1",
  "$comment": "PROVISIONAL: private brain inputs require comparison with the published brain subworkflows.",
  "x-lexia-contract-status": "provisional",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "correlation_id", "scope", "state", "messages", "contact", "operational_context", "company_fields", "policy", "capabilities"],
  "properties": {
    "schema_version": { "const": "lexia.brain.request.v1" },
    "invocation_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "scope": { "$ref": "#/$defs/scope" },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_version", "delivery_epoch"],
      "properties": {
        "state_version": { "type": "integer", "minimum": 0 },
        "delivery_epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "messages": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "contact": { "type": "object" },
    "operational_context": { "type": "object" },
    "company_fields": { "type": "object" },
    "policy": { "type": "object" },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "reprocess": {
      "$comment": "Present only when an unsent reply was discarded because a newer lead message arrived. Delivered actions and executed tool effects must not be repeated.",
      "type": "object",
      "additionalProperties": false,
      "required": ["superseded_invocation_ids", "delivered_action_ids", "executed_tool_effects"],
      "properties": {
        "superseded_invocation_ids": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
        "delivered_action_ids": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
        "executed_tool_effects": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/executedToolEffect" } }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "cliente_slug", "channel", "account_ref", "conversation_ref"],
      "properties": {
        "environment": { "enum": ["local", "isolated_test", "staging", "production"] },
        "cliente_slug": { "type": "string" },
        "channel": { "enum": ["whatsapp", "instagram", "messenger"] },
        "account_ref": { "type": "string", "format": "uuid" },
        "conversation_ref": { "type": "string", "minLength": 1 }
      }
    },
    "executedToolEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "invocation_id", "operation", "result"],
      "properties": {
        "tool_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "invocation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "operation": { "enum": ["appointment.create", "appointment.cancel", "other"] },
        "result": { "const": "succeeded" },
        "appointment_ref": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "oneOf": [
        { "properties": { "operation": { "const": "other" } } },
        {
          "required": ["appointment_ref"],
          "properties": { "operation": { "enum": ["appointment.create", "appointment.cancel"] } }
        }
      ]
    }
  }
}
