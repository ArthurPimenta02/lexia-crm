{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.uselexia.invalid/omnichannel/v1/shared-delivery-request.schema.json",
  "title": "Shared delivery transport v1",
  "x-lexia-contract-status": "provisional",
  "$comment": "Local receiver verified; n8n node runtime and provider bindings still require isolated integration tests.",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request"],
      "properties": {
        "schema_version": {"enum": ["lexia.automation.delivery.request.v1", "lexia.followup.delivery.request.v1"]},
        "request": {"$ref": "https://contracts.uselexia.invalid/omnichannel/v1/automation-request.schema.json"},
        "lead_cutoff_seq": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "scope", "captured_state", "actions", "lead_cutoff_seq"],
      "properties": {
        "schema_version": {"const": "lexia.delivery.plan.request.v1"},
        "request_id": {"type": "string", "format": "uuid"},
        "scope": {"type":"object","additionalProperties":false,"required":["environment","cliente_slug","channel","account_ref","conversation_ref"],"properties":{"environment":{"enum":["local","isolated_test","staging","production"]},"cliente_slug":{"type":"string","minLength":1},"channel":{"enum":["whatsapp","instagram","messenger"]},"account_ref":{"type":"string","format":"uuid"},"conversation_ref":{"type":"string","minLength":1}}},
        "captured_state": {"type":"object","additionalProperties":false,"required":["state_version","delivery_epoch"],"properties":{"state_version":{"type":"integer","minimum":0},"delivery_epoch":{"type":"integer","minimum":0}}},
        "lead_cutoff_seq": {"type": "integer", "minimum": 0},
        "actions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "https://contracts.uselexia.invalid/omnichannel/v1/outbound-action.schema.json"}}
      }
    }
  ]
}
