{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.uselexia.invalid/omnichannel/v1/workflow-test-result.schema.json",
  "title": "Lexia Workflow Test Result v1",
  "$comment": "PROVISIONAL: traces are intentionally generic until every inactive target workflow is exercised in an isolated n8n instance.",
  "x-lexia-contract-status": "provisional",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target",
    "status",
    "provider_send_attempted",
    "summary",
    "trace"
  ],
  "properties": {
    "schema_version": { "const": "lexia.workflow.test.result.v1" },
    "run_id": { "type": "string", "format": "uuid" },
    "target": {
      "enum": [
        "omnichannel",
        "brain",
        "followup",
        "reminder",
        "create_appointment",
        "check_availability"
      ]
    },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "provider_send_attempted": { "const": false },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "trace": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "status"],
        "properties": {
          "step": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "enum": ["passed", "blocked", "failed", "simulated"] },
          "reason": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "output": { "type": "object" }
  }
}
