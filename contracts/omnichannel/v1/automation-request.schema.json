{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.uselexia.invalid/omnichannel/v1/automation-request.schema.json",
  "title": "Lexia Automation Request v1",
  "$comment": "PROVISIONAL: reminder and follow-up publishers have not yet been inventoried in n8n.",
  "x-lexia-contract-status": "provisional",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "kind", "scope", "source_ref", "due_at", "proposed_actions"],
  "properties": {
    "schema_version": { "const": "lexia.automation.request.v1" },
    "request_id": { "type": "string", "format": "uuid" },
    "kind": { "enum": ["appointment_reminder", "followup"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "cliente_slug", "channel", "account_ref", "conversation_ref"],
      "properties": {
        "environment": { "enum": ["local", "isolated_test", "staging", "production"] },
        "cliente_slug": { "type": "string" },
        "channel": { "enum": ["whatsapp", "instagram", "messenger"] },
        "account_ref": { "type": "string", "format": "uuid" },
        "conversation_ref": { "type": "string", "minLength": 1 }
      }
    },
    "source_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "due_at": { "type": "string", "format": "date-time" },
    "proposed_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://contracts.uselexia.invalid/omnichannel/v1/outbound-action.schema.json" }
    }
  }
}
