{
  "name": "lexia-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:miranda:calendar:local": "node --test tests/miranda-original-calendar-tools.test.mjs tests/miranda-original-brain.test.mjs tests/miranda-calendar-readonly.test.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "test:lote2:local": "tsx --test tests/omnichannel-*.test.ts tests/lote2-*.test.ts tests/miranda-v2-candidate-workflows.test.ts tests/miranda-v2-lab-runtime.test.ts tests/miranda-v2-staging-deployment.test.ts",
    "build:omni:test-workflows": "tsx n8n/omnichannel-test/generate.ts",
    "build:miranda:v2:candidates": "tsx scripts/build-miranda-v2-candidates.ts",
    "build:miranda:v2:staging": "node scripts/build-miranda-v2-staging-deployment.mjs",
    "build:miranda:v2:lab-runtime": "node scripts/build-miranda-v2-lab-deployment.mjs --output n8n/miranda-v2-lab-runtime",
    "build:miranda:v2:lab-deployment": "node scripts/build-miranda-v2-lab-deployment.mjs",
    "build:miranda:v2:review": "tsx scripts/build-miranda-v2-review-package.ts",
    "db:lote2:connectivity": "node scripts/check-lote2-db-connectivity.mjs",
    "db:lote2:redis:connectivity": "node scripts/check-lote2-redis-connectivity.mjs",
    "db:lote2:preflight": "node scripts/preflight-lote2-isolated.mjs",
    "db:lote2:apply:isolated": "node scripts/apply-lote2-isolated.mjs",
    "db:lote2:followup:isolated": "node scripts/apply-lote2-isolated-followup.mjs",
    "db:lote2:crm-followup:isolated": "node scripts/apply-lote2-crm-command-followup.mjs",
    "test:lote2:runtime:isolated": "tsx scripts/test-lote2-runtime-isolated.ts",
    "test:lote2:frappe:isolated": "tsx scripts/test-lote2-frappe-isolated.ts",
    "test:lote1:db:isolated": "node scripts/test-lote1-isolated.mjs",
    "test:lote1:isolated": "npm run test:lote1:db:isolated",
    "test:lote1:runtime:isolated": "node scripts/test-lote1-runtime-next.mjs",
    "db:lote1:connectivity": "node scripts/check-lote1-db-connectivity.mjs",
    "db:lote1:runtime:harness": "node scripts/apply-lote1-runtime-harness.mjs",
    "db:lote1:runtime:verify": "node scripts/apply-lote1-runtime-harness.mjs --verify-only",
    "db:lote1:index": "node scripts/apply-profile-unique-index.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.47.0",
    "next": "16.2.9",
    "openai": "^7.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "luxon": "3.7.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
